# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Editor configuration
.vscode/
.idea/

# Server runtime data
#
# teamak.db is the local SQLite database. It is regenerated and seeded
# automatically on first run, so it is never committed.
server/teamak.db
server/teamak.db-journal
server/teamak.db-wal
server/teamak.db-shm

# Documents uploaded through /applications/:id/documents.
# The metadata lives in the database; the binaries stay local.
uploads/
**/uploads/
